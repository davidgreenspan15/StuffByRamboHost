# Copy names into Supabase Edge Function secrets. Never commit actual values.
# The project ref is a public identifier used to pin credential-bearing requests
# to this test project; it is not a secret.
EXPECTED_SUPABASE_PROJECT_REF=rilxmoeezbmpvmcfkyko
SUPABASE_URL=https://rilxmoeezbmpvmcfkyko.supabase.co
SUPABASE_ANON_KEY=replace_in_secret_store
SUPABASE_SERVICE_ROLE_KEY=replace_in_secret_store

STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=replace_in_secret_store
STRIPE_WEBHOOK_SECRET=replace_in_secret_store
STRIPE_API_VERSION=replace_with_dashboard_approved_pinned_version

# Managed Payments is Public Preview and must be deliberately enabled only
# after Dashboard enrollment, terms acceptance, eligible tax-code review, and
# sandbox verification. Standard Stripe is the default fallback.
STRIPE_MANAGED_PAYMENTS_ENABLED=false
STRIPE_MANAGED_PAYMENTS_TERMS_ACCEPTED=false
# Comma-separated codes explicitly verified against Stripe's current eligible
# Managed Payments digital-product list. Required only when enabled; do not guess.
STRIPE_MANAGED_PAYMENTS_ELIGIBLE_TAX_CODES=
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Test services may boot with these false, but Checkout remains unavailable.
# Live services fail startup until both approvals are complete.
STRIPE_STANDARD_US_ONLY_ACKNOWLEDGED=false
STRIPE_STANDARD_TAX_CONFIGURATION_REVIEWED=false

SITE_ORIGIN=https://stuffbyrambo.com
ALLOWED_SITE_ORIGINS=https://stuffbyrambo.com,https://www.stuffbyrambo.com
LICENSE_ORIGIN=https://licenses.stuffbyrambo.com
CHECKOUT_SUCCESS_URL=https://stuffbyrambo.com/gesture-flow/success.html?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://stuffbyrambo.com/gesture-flow/canceled.html

# Generate independent random values of at least 32 bytes. Do not reuse them.
ACTIVATION_CODE_HMAC_SECRET=replace_in_secret_store
CONTEXT_HMAC_SECRET=replace_in_secret_store
COMMERCE_CRON_SECRET=replace_in_secret_store
UPSTREAM_PROXY_SECRET=replace_in_secret_store
ALLOW_LOCAL_DIRECT_REQUESTS=false

# Ed25519 JWKs. The private JWK exists only in Supabase secrets; only public
# raw keys are embedded in signed app builds.
PERMIT_SIGNING_KEY_ID=gf-2026-01
PERMIT_SIGNING_PRIVATE_JWK=replace_in_secret_store
PERMIT_SIGNING_PUBLIC_JWKS=replace_with_public_jwks_json

# Private TEST-only purchase activation codes. All default false; startup
# rejects them outside STRIPE_ENVIRONMENT=test or without a recipient list.
PRIVATE_PURCHASE_CODES_ENABLED=false
PRIVATE_ACTIVATION_EMAIL_SENDING_ENABLED=false
# JSON array of exact allowlisted recipient emails.
PRIVATE_ACTIVATION_RECIPIENTS=[]
# Sender on the verified Resend domain, e.g. "Gesture Flow <name@verified-domain>".
PRIVATE_ACTIVATION_EMAIL_FROM=
# Production (live) purchase codes, LIC-003. Both default false; startup
# rejects them unless STRIPE_ENVIRONMENT=live, and rejects sending without
# PRIVATE_ACTIVATION_EMAIL_FROM and RESEND_API_KEY. The database gate
# commerce_purchase_code_settings.live_enabled must also be on (operator SQL).
LIVE_PURCHASE_CODES_ENABLED=false
LIVE_PURCHASE_CODE_EMAIL_SENDING_ENABLED=false
# Optional JSON array canary for a staged live rollout. Omit to serve every
# verified live buyer; an empty array is rejected.
# LIVE_PURCHASE_CODE_CANARY_RECIPIENTS=["you@example.com"]
# Resend HTTP API key (secret store only). Without it the sender fails closed.
RESEND_API_KEY=
